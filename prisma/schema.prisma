generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (blueprint §4 / §5)
// ---------------------------------------------------------------------------

enum EventStatus {
  DRAFT
  READY
  PUBLISHED
  LIVE
  INTERMISSION
  FINISHED
  CANCELLED
  ARCHIVED
}

enum BoutStatus {
  DRAFT
  TBD
  CONFIRMED
  READY
  DELAYED
  IN_PROGRESS
  FINAL
  SCRATCHED
  NO_SHOW
}

enum RequestStatus {
  PENDING
  PARTIAL
  COMPLETE
  DECLINED
  EXPIRED
}

enum NominationStatus {
  CREATED
  PENDING
  ACCEPTED
  CONFIRMED
  DECLINED
  WITHDRAWN
  REPLACEMENT
}

enum ClubTier {
  FREE
  PRO
}

enum ScratchReason {
  INJURY
  WITHDRAWAL
  NO_OPPONENT
  ORGANIZER_DECISION
  OTHER
}

enum MediaKind {
  EVENT_COVER
  EVENT_GALLERY
  SPONSOR
  BOUT_MEDIA
  SPARRING_MEDIA
}

enum MediaAttachedType {
  EVENT
  BOUT
  SPARRING_SESSION
}

// blueprint §9 — event-driven only, no social notifications.
enum NotificationType {
  NOMINATED
  NOMINATION_ACCEPTED
  NOMINATION_DECLINED
  EVENT_PUBLISHED
  EVENT_CANCELLED
  SCHEDULE_CHANGED
  BOUT_DELAYED
  BOUT_SCRATCHED
  BOUT_LIVE
  BOUT_RESULT
  EVENT_FINISHED
  SPARRING_REQUESTED
  SPARRING_ACCEPTED
  SPARRING_DECLINED
  SPARRING_MATCHED
  SPARRING_INVITED
  CHECKIN_OPEN
}

enum CheckInAttachedType {
  EVENT
  SPARRING_SESSION
}

enum CheckInStatus {
  CHECKED_IN
  NO_SHOW
  LATE
}

enum SparringSessionStatus {
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum SparringParticipantStatus {
  REQUESTED
  INVITED
  CONFIRMED
  REJECTED
  CANCELLED
  CHECKED_IN
  COMPLETED
  NO_SHOW
}

enum SparringMatchStatus {
  SUGGESTED
  CONFIRMED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Contexts (existence-based, never exclusive — see components/nav/TabBar.tsx):
  fighterProfile   FighterProfile?   // "Boxer" context
  organizerProfile OrganizerProfile? // "Organizer" context (independent, no club needed)

  // Club admin memberships (many-to-many via join table) — the "Club" context(s)
  clubAdminships   ClubAdmin[]

  // Events this user may host-manage (creator + club admins at event creation)
  hostEvents       EventHostMember[]

  createdEvents    Event[]        @relation("EventCreatedBy")
  follows          Follow[]
  notifications    Notification[]
  uploadedMedia    Media[]
}

model Club {
  id        String   @id @default(cuid())
  name      String
  city      String?
  venue     String?
  tier      ClubTier @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins       ClubAdmin[]
  roster       FighterProfile[]
  requests     EventRequest[]
  nominations  Nomination[]
  organizedEvents Event[] @relation("EventOrganizingClub")
  sparringSessions SparringSession[]
}

model ClubAdmin {
  id       String @id @default(cuid())
  clubId   String
  userId   String
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

model FighterProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String
  clubId           String?
  club             Club?    @relation(fields: [clubId], references: [id])
  weightClass      String?
  stance           String?
  style            String?
  sex              String?
  dateOfBirth      DateTime?
  experienceLevel  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  nominations     Nomination[]
  boutsAsFighterA Bout[] @relation("BoutFighterA")
  boutsAsFighterB Bout[] @relation("BoutFighterB")
  sparringParticipations SparringParticipant[]
  checkIns        CheckIn[]
}

/** The standalone "Organizer" context — for organizing without a club. */
model OrganizerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  createdAt   DateTime @default(now())
}

model Event {
  id                 String      @id @default(cuid())
  slug               String?     @unique
  code               String?     @unique
  name               String
  venue              String?
  city               String?
  date               DateTime
  startTime          DateTime?
  sport              String      @default("Boxing")
  description        String?
  streamUrl          String?
  status             EventStatus @default(DRAFT)
  organizingClubId   String?
  organizingClub     Club?       @relation("EventOrganizingClub", fields: [organizingClubId], references: [id])
  createdByUserId    String
  createdBy          User        @relation("EventCreatedBy", fields: [createdByUserId], references: [id])
  dayCount           Int         @default(1)
  ringCount          Int         @default(1)
  cancelReason       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  hostMembers  EventHostMember[]
  requests     EventRequest[]
  nominations  Nomination[]
  bouts        Bout[]
  rings        Ring[]
  follows      Follow[]
}

/** A physical ring/station within an event — nameable, independently live/on-break. */
model Ring {
  id        String   @id @default(cuid())
  eventId   String
  number    Int
  name      String?
  onBreak   Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bouts Bout[]

  @@unique([eventId, number])
}

// hostMemberUserIds[] modeled as a join table
model EventHostMember {
  id      String @id @default(cuid())
  eventId String
  userId  String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventRequest {
  id           String        @id @default(cuid())
  eventId      String
  clubId       String
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  club         Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  requirements Json          // [{ weightClass, need }]
  deadline     DateTime?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([eventId, clubId])
}

model Nomination {
  id           String           @id @default(cuid())
  eventId      String
  clubId       String
  fighterId    String
  weightClass  String
  status       NominationStatus @default(CREATED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  club    Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fighter FighterProfile @relation(fields: [fighterId], references: [id], onDelete: Cascade)
}

model Bout {
  id             String        @id @default(cuid())
  eventId        String
  number         Int
  weightClass    String
  ringId         String
  day            Int           @default(1)
  fighterAId     String?
  fighterBId     String?
  status         BoutStatus    @default(DRAFT)
  scheduledTime  DateTime?
  delayMinutes   Int?
  scratchReason  ScratchReason?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ring      Ring            @relation(fields: [ringId], references: [id])
  fighterA  FighterProfile? @relation("BoutFighterA", fields: [fighterAId], references: [id])
  fighterB  FighterProfile? @relation("BoutFighterB", fields: [fighterBId], references: [id])
  result    Result?

  @@unique([eventId, number])
}

model Result {
  id       String  @id @default(cuid())
  boutId   String  @unique
  bout     Bout    @relation(fields: [boutId], references: [id], onDelete: Cascade)
  winnerId String?
  loserId  String?
  method   String
  round    Int?

  createdAt DateTime @default(now())
}

model Follow {
  id      String @id @default(cuid())
  userId  String
  eventId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// Club-to-club sparring board — isolated from competition data (blueprint §0
// item 11 / design master: "NOT a fighter marketplace"). Never writes into
// Bout/Event.
// Individual-fighter sparring marketplace: a club hosts a SparringSession,
// fighters discover and register (REQUESTED -> host CONFIRMED/REJECTED),
// the host organizes registrants into SparringWeightGroups, and pairs
// confirmed fighters into SparringMatches (suggested or host-confirmed).
model SparringSession {
  id              String                @id @default(cuid())
  clubId          String
  club            Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  sport           String                @default("Boxing")
  gym             String
  city            String?
  date            DateTime
  rulesText       String?
  minAge          Int?
  maxAge          Int?
  sex             String?
  experienceLevel String?
  status          SparringSessionStatus @default(OPEN)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  weightGroups SparringWeightGroup[]
  participants SparringParticipant[]
  matches      SparringMatch[]
}

model SparringWeightGroup {
  id        String @id @default(cuid())
  sessionId String
  session   SparringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  label     String
  order     Int    @default(0)

  participants SparringParticipant[]
}

model SparringParticipant {
  id            String                     @id @default(cuid())
  sessionId     String
  session       SparringSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fighterId     String
  fighter       FighterProfile             @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  weightGroupId String?
  weightGroup   SparringWeightGroup?       @relation(fields: [weightGroupId], references: [id])
  status        SparringParticipantStatus  @default(REQUESTED)
  note          String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  matchesAsA SparringMatch[] @relation("MatchParticipantA")
  matchesAsB SparringMatch[] @relation("MatchParticipantB")

  @@unique([sessionId, fighterId])
}

model SparringMatch {
  id             String              @id @default(cuid())
  sessionId      String
  session        SparringSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantAId String
  participantA   SparringParticipant @relation("MatchParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   SparringParticipant @relation("MatchParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  status         SparringMatchStatus @default(SUGGESTED)
  createdAt      DateTime            @default(now())
}

// Phase 3 — one generic model for every media type (cover/gallery/sponsor/bout
// photo/sparring photo) via `kind` + a polymorphic (attachedType, attachedId)
// pair, rather than a model per attachment target. No real FK to the parent —
// Prisma can't express a clean polymorphic relation, and a deleted parent's
// Media rows become harmless orphans since every read is scoped by
// (attachedType, attachedId) against a live parent.
model Media {
  id               String            @id @default(cuid())
  url              String
  kind             MediaKind
  attachedType     MediaAttachedType
  attachedId       String
  uploadedByUserId String
  uploadedBy       User              @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime          @default(now())

  @@index([attachedType, attachedId])
}

// Same polymorphic pattern as Media — one model for event and sparring
// check-in rather than two near-identical tables.
model CheckIn {
  id           String              @id @default(cuid())
  attachedType CheckInAttachedType
  attachedId   String
  fighterId    String
  fighter      FighterProfile      @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  status       CheckInStatus       @default(CHECKED_IN)
  checkedInAt  DateTime            @default(now())

  @@unique([attachedType, attachedId, fighterId])
  @@index([attachedType, attachedId])
}
